[Unit]
Description=Shared Clipboard
PartOf=graphical-session.target
After=graphical-session.target
# Give up after 5 quick failures, as when the compositor has no data-control.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=%h/.local/bin/sharedclip daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
